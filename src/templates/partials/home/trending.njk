<div class="trending">

    <div class="trending__header">
        <div class="trending__text">
            <span class="trending__tag">TRENDING</span>
            <h2 class="trending__title heading-h2">Popular Products</h2>
        </div>    
        
        <div class="trending__buttons">
            <button class="button button--secondary button--icon-lg">
                {% from 'src/templates/partials/ui/icon.njk' import icon %}
                {{ icon("icon-chevron-left") }}
            </button>
            <button class="button button--secondary button--icon-lg">
