    <div class="blog-section__container">
    {% from 'src/templates/partials/ui/icon.njk' import picture %}

    {% for post in blogPosts %}
        <div class="blog-section__item">
            {{ picture("blog-section__image", post.image, post.alt) }}
            <div class="blog-section__text">
                <h3 class="blog-section__title">{{ post.title }}</h3>
                <time class="blog-section__date" datetime="{{ post.date }}">{{ post.dateDisplay }}</time>
            </div>
        </div>
    {% endfor %}
    </div>


</div>
