<form class="form">

	<div class="form__fields">

		<div class="form__fields-group">
			<label for="full-name">Full Name</label>
			<input type="text" id="full-name" name="full-name" class="form-field" placeholder="Amelia Robert Johnson" required>
		</div>

		<div class="form__fields-group">
			<label for="email">Email Address</label>
			<input type="email" id="email" name="email" class="form-field" placeholder="amelia.robertjohnson@pixmart.com" required>
		</div>

		<div class="form__fields-group">
			<label for="subject">Subject</label>
			<select id="subject" name="subject" class="form-input" required>
				<option value="">Select a subject</option>
				<option value="general">General Inquiry</option>
				<option value="support">Support</option>
				<option value="feedback">Feedback</option>
			</select>
		</div>

		<div class="form__fields-group">
			<label for="message">Message</label>
			<textarea id="message" name="message" class="form-field--textarea" placeholder="Enter your message ..." required></textarea>
		</div>

	</div>

	<div class="form__submit-area">

		<div class="form__options">
			<label class="form__options-option">
				<input type="checkbox" class="default-checkbox" name="subscribe">
				<span class="custom-checkbox"></span>
				Subscribe me to Newsletter
			</label>

			<label class="form__options-option">
				<input type="checkbox" class="default-checkbox" name="privacy" required>
				<span class="custom-checkbox"></span>
				I have read the User & Privacy Policy
			</label>
			
		</div>

		<button type="submit" class="form__button button button--primary button--lg">
			Send Message
		</button>

	</div>

</form>
